<?xml version="1.0"?>
<!--
  Module: HEX_FixImageResizeQueue
  Purpose: Prevent stale image filenames being enqueued for admin image resize.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="HEX_FixImageResizeQueue" setup_version="1.0.0">
        <sequence>
            <module name="Magento_Catalog"/>
            <module name="Magento_MediaStorage"/>
        </sequence>
    </module>
</config>
